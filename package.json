{
  "name": "menuchi-app",
  "version": "1.0.0",
  "description": "The backend of Menuchi",
  "main": "index.js",
  "scripts": {
    "dev": "npx tsoa spec-and-routes && ts-node --files ./src/index.ts",
    "build": "npx tsc",
    "start": "node ./build/index.js",
    "lint": "eslint src test --max-warnings=0",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config ./test/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config ./test/vitest.config.ts",
    "db-push": "npx prisma db push --schema=./src/db/schema.prisma --accept-data-loss",
    "db-generate": "npx prisma --schema=./src/db/schema.prisma",
    "db:migrate:dev": "npx prisma migrate dev --schema=./src/db/schema.prisma",
    "db:deploy": "npx prisma migrate deploy --schema=./src/db/schema.prisma",
    "docker:build": "docker build -t menuchi.api:dev .",
    "docker:up": "docker compose -f docker-compose.dev.yml up --build",
    "prisma:studio": "npx prisma studio --schema=./src/db/schema.prisma",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menuchi-project/menuchi-app"
  },
  "keywords": [],
  "author": "Mohammad Hosseini",
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "type": "commonjs",
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "test/**/*.{ts,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
  "bugs": {
    "url": "https://github.com/menuchi-project/menuchi-app/issues"
  },
  "homepage": "https://github.com/menuchi-project/menuchi-app#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/s3-request-presigner": "^3.777.0",
    "@prisma/client": "^6.7.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.2",
    "connect-redis": "^8.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.7.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "typescript": "^5.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.1.2",
    "@vitest/ui": "^3.1.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.1.2",
    "vitest-mock-extended": "^3.1.0"
  }
}
