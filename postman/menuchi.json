{"info": {"name": "menuchi-backend", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "MenuChi backend — owner auth, OTP customer auth, orders. Base URL http://localhost:8000. Swagger: /docs."}, "item": [{"name": "Health", "item": [{"name": "liveness", "request": {"method": "GET", "url": "{{baseUrl}}/health"}}, {"name": "readiness", "request": {"method": "GET", "url": "{{baseUrl}}/ready"}}]}, {"name": "Auth", "item": [{"name": "owner-signup", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/res-signup", "body": {"mode": "raw", "raw": "{\"phoneNumber\":\"09123456789\",\"password\":\"secret123\",\"username\":\"owner1\"}"}}}, {"name": "owner-signin", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/res-signin", "body": {"mode": "raw", "raw": "{\"phoneNumber\":\"09123456789\",\"password\":\"secret123\"}"}}}, {"name": "send-otp", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/send-otp", "body": {"mode": "raw", "raw": "{\"email\":\"guest@example.com\"}"}}}, {"name": "check-otp", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/check-otp", "body": {"mode": "raw", "raw": "{\"email\":\"guest@example.com\",\"code\":\"123456\"}"}}}]}, {"name": "Orders", "item": [{"name": "create-order-customer", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/menus/:menuId/orders", "body": {"mode": "raw", "raw": "{\"items\":[{\"itemId\":\"<itemId>\",\"amount\":2}]}"}}}, {"name": "create-order-by-owner", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/menus/:menuId/orders/by-owner", "body": {"mode": "raw", "raw": "{\"customerEmai